{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "kubernetes": {
    "managerFilePatterns": ["/^k8s/.+\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned release tags in the artifact list; latest and latest-prerelease are skipped",
      "managerFilePatterns": ["/(^|/)artifacts$/"],
      "matchStrings": [
        "(?:^|\\n)(?<depName>[\\w.-]+/[\\w.-]+)[ \\t]+(?<currentValue>v?\\d[^\\s]*)[ \\t]"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
